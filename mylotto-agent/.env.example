# ─────────────────────────────────────────────
# Lotto Agent · Environment Variables Example
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Data ─────────────────────────────────────
DATA_DIR=data
LOTTO_RESULTS_CSV=data/lotto_draw_results.csv
GENERATED_GAMES_CSV=data/generated_games.csv

# ── 동행복권 API ──────────────────────────────
DH_API_URL=https://www.dhlottery.co.kr/common.do
DH_API_TIMEOUT=10

# ── Telegram Bot (optional) ──────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── AWS S3 (optional) ────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=your-lotto-bucket
S3_PREFIX=lotto/

# ── AWS EC2 (optional) ───────────────────────
EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
EC2_KEY_PAIR_NAME=your-key-pair

# ── Playwright / 동행복권 구매 자동화 (optional) ──
DH_LOGIN_ID=your_dhlottery_id
DH_LOGIN_PW=your_dhlottery_password
HEADLESS=true

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
